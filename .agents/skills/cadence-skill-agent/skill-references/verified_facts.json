    {
      "id": "axlShellPost-underscore-prefix",
      "api": "axlShellPost",
      "constraint": "post 命令内链超过一条命令时,后续命令必须加 `_` 前缀以抑制 scripting,例如 axlShellPost(\"zoom points; _pick 10 20\")。",
      "evidence": [{"path": "algroskill/09cmdshl.md", "line": 632}],
      "verified_on": {"allegro": "17.2-2016"},
      "status": "documented",
      "source": "reference-doc"
    },
    {
      "id": "axlShellPost-no-override-infinite-loop",
      "api": "axlShellPost",
      "constraint": "不得用 axlShellPost 覆盖已有 Allegro PCB Editor 命令后再调用原命令——会产生死循环。",
      "evidence": [{"path": "algroskill/09cmdshl.md", "line": 636}],
      "verified_on": {"allegro": "17.2-2016"},
      "status": "documented",
      "source": "reference-doc"
    },
    {
      "id": "axlShellPost-returns-before-execute",
      "api": "axlShellPost",
      "constraint": "axlShellPost 先返回 Skill 解释器,再执行命令;命令在 Skill 返回后才激活并留给用户交互(即返、非阻塞)。真机实测 connect-post 探针:elapsed 0.08s、fire_and_forget=True、shell_return=t。",
      "evidence": [
        {"path": "algroskill/09cmdshl.md", "line": 632},
        {"probe": ".artifacts/connect-probes-fixed-full/connect-post.json"}
      ],
      "verified_on": {"allegro": "17.2-2016 S048"},
      "status": "verified",
      "source": "probe+reference-doc"
    },
    {
      "id": "axlShell-no-done-cancel-signal",
      "api": "axlShell",
      "constraint": "axlShell 对纯交互命令无完成/取消的直接信号,恒返回 t;用户取消时非阻塞返回,必须快照命令前后状态对比判定 done/cancel。真机实测 connect-blocking 探针:blocking_semantics=non_blocking、route_change=cancel、ping=3(通道存活)。",
      "evidence": [
        {"path": "algroskill/09cmdshl.md", "line": 590},
        {"probe": ".artifacts/connect-probes-fixed-full/connect-blocking.json"}
      ],
      "verified_on": {"allegro": "17.2-2016 S048"},
      "status": "verified",
      "source": "probe+reference-doc"
    },
