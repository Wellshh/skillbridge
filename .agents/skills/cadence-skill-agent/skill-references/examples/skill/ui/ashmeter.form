# See ashmeter.il
FILE_TYPE=FORM_DEFN VERSION=2
FORM 
FIXED
PORT 42 5
HEADER "Progress Meter Demonstration"

TILE

TEXT
TLOC 1 3
INFO progressText 40
ENDTEXT

TEXT
TLOC 1 5
INFO progressText2 40
OPTIONS underline bold
ENDTEXT


FIELD bar
FLOC 1 1
PROGRESS 41 3
ENDFIELD

FIELD info
FLOC 34 5
MENUBUTTON "Info" 6 3
ENDFIELD

ENDTILE

ENDFORM

