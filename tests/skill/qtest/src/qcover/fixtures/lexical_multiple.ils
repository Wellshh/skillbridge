;;; lexical_multiple.ils - Phase 1A whole-file qualification fixture.

(if t
    'topLevel
  'unexpectedTopLevel)

(letseq ((counter 0)
         (worker
           (lambda (value)
             (if (progn
                   (setq counter (add1 counter))
                   value)
                 'yes
               'no))))
  (defglobalfun qcoverIlsMultipleCall (value)
    (funcall worker value))
  (defglobalfun qcoverIlsMultipleCount ()
    counter)
  (defglobalfun qcoverIlsMultipleQuoted ()
    '(if(t then 'yes else 'no))))
