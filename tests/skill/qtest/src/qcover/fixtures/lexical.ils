;;; lexical.ils - Phase 0 qualification fixture for SKILL++ qcover support.

(let ((worker
        (lambda (value)
          (if value
              'yes
            'no))))
  (defglobalfun qcoverIlsFixtureCall (value)
    (funcall worker value)))
