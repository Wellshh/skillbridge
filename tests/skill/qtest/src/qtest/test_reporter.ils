;;; test_reporter.ils - Self-tests for the qtest reporter (progress dots, table, summary).

(qtest::runSuites
  (qtest::TestSuite ()
    (qtest::TestCase test_progress_markers
      (qtest::assertEqual
        '("." "F" "s" "x")
        (mapcar qtest:::progressMarker '(Pass Fail Skip ExpF))
        ?msg "progress markers match every result status"))

    (qtest::TestCase test_status_text
      (qtest::assertEqual "PASS" (qtest:::statusText 'Pass) ?msg "Pass status text")
      (qtest::assertEqual "FAIL" (qtest:::statusText 'Fail) ?msg "Fail status text")
      (qtest::assertEqual "SKIP" (qtest:::statusText 'Skip) ?msg "Skip status text")
      (qtest::assertEqual "XFAIL" (qtest:::statusText 'ExpF) ?msg "Expected-fail status text")))

  (qtest::TestSuite ()
    (qtest::TestCase test_format_table_contains_rows_and_header
      (letseq ((pass (qtest:::makeResult 'Pass "ok" () ()))
               (fail (qtest:::makeResult 'Fail "boom" '(a b) '(1 2)))
               (table (qtest:::formatTable
                        (list (list 'test_alpha pass)
                              (list 'test_beta fail)))))
        (qtest::assertTrue
          (and (index table "test_alpha")
               (index table "PASS")
               (index table "test_beta")
               (index table "FAIL")
               (index table "Test")
               (index table "Status")
               (index table "Detail"))
          ?msg "table contains every name, status, and the header")))

    (qtest::TestCase test_format_table_pass_detail_is_dash
      (let ((table (qtest:::formatTable
                     (list (list 'test_dash
                                 (qtest:::makeResult 'Pass "ok" () ()))))))
        (qtest::assertTrue (index table "-")
                           ?msg "pass detail is a dash")))

    (qtest::TestCase test_format_table_fail_detail_has_eval
      (let ((table (qtest:::formatTable
                     (list (list 'test_eval
                                 (qtest:::makeResult 'Fail "boom" '(x) '(1)))))))
        (qtest::assertTrue
          (and (index table "eval:")
               (index table "boom"))
          ?msg "fail detail shows evaluated inputs and the message")))

    ;; Stateful: this suite runs before project suites, so it can clear the
    ;; accumulator without preserving unrelated results.
    (qtest::TestCase test_record_and_summary_clears
      (let (p1
            p2
            s1
            s2
            failed
            emptyFailed
            result)
        (unwindProtect
          (progn
            (setq p1 (outstring))
            (setq p2 (outstring))
            (qtest:::recordResults
              (list (list 'rec_one (qtest:::makeResult 'Pass "ok" () ()))
                    (list 'rec_two (qtest:::makeResult 'Fail "boom" '(x) '(1)))))
            (setq failed (qtest::printSummary ?port p1))
            (setq s1 (getOutstring p1))
            (setq emptyFailed (qtest::printSummary ?port p2))
            (setq s2 (getOutstring p2))
            (setq result
                  (qtest::assertEqual
                    '(t t t 1 nil 0)
                    (list (not (null (index s1 "rec_one")))
                          (not (null (index s1 "rec_two")))
                          (not (null (index s1 "passed")))
                          failed
                          (index s2 "rec_one")
                          emptyFailed)
                    ?msg "summary reports failures and clears its accumulator")))
          (progn
            (when p1 (close p1))
            (when p2 (close p2))
            (setq qtest:::_results nil)))
        result))))
