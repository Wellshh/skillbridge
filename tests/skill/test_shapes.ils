;;; test_shapes.ils - Unit tests for the lazy shape projection extension.

(qcover::load (strcat (qub::scriptDir)
                      "/../../allegrobridge/server/extensions/shapes.il"))

(qtest::runSuites
  (qtest::TestSuite ()
    (qtest::TestCase test_shape_projection_has_stable_attributes
      (letseq ((shape (list nil 'net (list nil 'name "GND")
                            'layer "ETCH/TOP" 'shapeIsBoundary t
                            'bBox '((1.0 2.0) (3.0 4.0)) 'dbid "db:1"))
               (projected (__abProjectShape shape)))
        (qtest::assertEqual "GND" (get projected 'net))
        (qtest::assertEqual "ETCH/TOP" (get projected 'layer))
        (qtest::assertEqual "dynamic" (get projected 'dynamic))
        (qtest::assertEqual 1.0 (get (get (get projected 'bbox) 'll) 'x))
        (qtest::assertEqual 4.0 (get (get (get projected 'bbox) 'ur) 'y))
        (qtest::assertNil (get projected 'dbid))))

    (qtest::TestCase test_shape_projection_handles_static_dummy_net
      (letseq ((shape (list nil 'net "" 'layer "BOARD GEOMETRY/OUTLINE"
                            'shapeIsBoundary nil 'bBox '((0.0 0.0) (1.0 1.0))))
               (projected (__abProjectShape shape)))
        (qtest::assertNil (get projected 'net))
        (qtest::assertEqual "static" (get projected 'dynamic))))

    (qtest::TestCase test_shapes_projection_lists_and_filters
      (let ((shapes (__abProjectShapes nil nil nil))
            net
            dynamicLayer
            staticLayer)
        (foreach shape shapes
          (when (get shape 'net)
            (setq net (get shape 'net)))
          (if (equal (get shape 'dynamic) "dynamic")
              (setq dynamicLayer (get shape 'layer))
              (setq staticLayer (get shape 'layer))))
        (qtest::assertTrue shapes)
        (qtest::assertTrue net)
        (qtest::assertTrue dynamicLayer)
        (qtest::assertTrue staticLayer)
        (qtest::assertTrue (__abProjectShapes net nil nil))
        (qtest::assertTrue (__abProjectShapes nil dynamicLayer "dynamic"))
        (qtest::assertTrue (__abProjectShapes nil staticLayer "static"))
        (qtest::assertNil (__abProjectShapes "__MISSING_NET__" nil nil))
        (qtest::assertNil (__abProjectShapes nil "__MISSING_LAYER__" nil))
        (qtest::assertNil (__abProjectShapes nil nil "__MISSING_STATE__"))))))
