  (qtest::TestSuite ((actual nil))
    (qtest::TestCase test_real_ipc_callbacks_retain_lexical_data_after_return
      (setq actual
        (let (process data finished)
          (setq data "")
          (setq finished nil)
          (setq process
            (ipcBeginProcess
              "cmd /c echo lexical-data"
              ""
              (lambda (_id chunk) (setq data (strcat data chunk)))
              nil
              (lambda (_id status) (setq finished status))))
          (ipcWait process 1 10)
          (list (not (null process)) (index data "lexical-data") finished)))
      (qtest::assertTrue (car actual))
      (qtest::assertTrue (cadr actual))
      (qtest::assertEqual 0 (caddr actual)))))
