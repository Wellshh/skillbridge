;;; test_server.ils - Unit tests for python_server.il using qtest

(qcover::load (strcat (qub::scriptDir) "/../../skillbridge/server/python_server.il"))

(defun __pyTestServerState ()
  (list pyStartServer.ipc
        pyStartServer.id
        pyStartServer.logLevel
        pyStartServer.singleMode
        pyStartServer.timeout
        pyStartServer.python
        pyStartServer.forceTcp
        pyStartServer.restartPending
        pyStartServer.requestIpc
        pyStartServer.state))

(defun __pyTestRestoreServerState (state)
  pyStartServer.ipc = (nth 0 state)
  pyStartServer.id = (nth 1 state)
  pyStartServer.logLevel = (nth 2 state)
  pyStartServer.singleMode = (nth 3 state)
  pyStartServer.timeout = (nth 4 state)
  pyStartServer.python = (nth 5 state)
  pyStartServer.forceTcp = (nth 6 state)
  pyStartServer.restartPending = (nth 7 state)
  pyStartServer.requestIpc = (nth 8 state)
  pyStartServer.state = (nth 9 state)
  t)

(defun __pyTestWriteLines (fileName lines)
  (let ((port (outfile fileName)))
    (unless port
      (error "test_server: cannot create temporary file %s" fileName))
    (unwindProtect
      (foreach line lines
        (fprintf port "%s\n" line))
      (close port)))
  t)

(qtest::runSuites
  ;; Suite 1: Scalar data types serialization
  (qtest::TestSuite ()
    (qtest::TestCase test_serialize_boolean
      (qtest::assertEqual "True" (__pySkillToPython t) ?msg "Boolean t must serialize to True")
      (qtest::assertEqual "None" (__pySkillToPython nil) ?msg "nil must serialize to None"))

    (qtest::TestCase test_serialize_numbers
      (qtest::assertEqual "42" (__pySkillToPython 42) ?msg "Integer serialization failed")
      (qtest::assertEqual "-10" (__pySkillToPython -10) ?msg "Negative integer serialization failed")
      (qtest::assertEqual "3.14" (__pySkillToPython 3.14) ?msg "Float serialization failed"))

    (qtest::TestCase test_serialize_string
      (qtest::assertEqual "\"hello world\"" (__pySkillToPython "hello world") ?msg "String serialization failed")
      (qtest::assertEqual "\"\"" (__pySkillToPython "") ?msg "Empty string serialization failed"))

    (qtest::TestCase test_serialize_symbol
      (qtest::assertEqual "Symbol('my_symbol')" (__pySkillToPython 'my_symbol) ?msg "Symbol serialization failed")))

  ;; Suite 2: List and Disembodied Property List serialization
  (qtest::TestSuite ()
    (qtest::TestCase test_serialize_list
      (qtest::assertEqual "None" (__pySkillToPython (list)) ?msg "Empty SKILL list is nil and must serialize to None")
      (qtest::assertEqual "[1,2,3]" (__pySkillToPython (list 1 2 3)) ?msg "List of integers failed")
      (qtest::assertEqual "[\"a\",True,None]" (__pySkillToPython (list "a" t nil)) ?msg "Heterogeneous list failed")
      (qtest::assertEqual "[1,[2,3]]" (__pySkillToPython (list 1 (list 2 3))) ?msg "Nested list failed"))

    (qtest::TestCase test_serialize_disembodied_property_list
      ;; D-list format: (nil prop1 val1 prop2 val2)
      (qtest::assertEqual "{'a':1,'b':2}" (__pySkillToPython (list nil 'a 1 'b 2)) ?msg "D-list with integers failed")
      (qtest::assertEqual "{'name':\"skillbridge\"}" (__pySkillToPython (list nil 'name "skillbridge")) ?msg "D-list with string failed")))

  ;; Suite 3: Table and Vector container serialization
  (qtest::TestSuite ()
    (qtest::TestCase test_serialize_table
      (let ((tbl (makeTable "testTable" nil)))
        (tbl["key"] = 123)
        (qtest::assertTrue (qub::startsWith (__pySkillToPython tbl) "Table(\"__py_table_")
                           ?msg "Table serialization prefix check failed")))

    (qtest::TestCase test_serialize_vector
      (let ((vec (makeVector 2 nil)))
        (qtest::assertTrue (qub::startsWith (__pySkillToPython vec) "Vector(\"__py_vector_")
                           ?msg "Vector serialization prefix check failed"))))

  ;; Suite 4: Default server configuration and initial state
  (qtest::TestSuite ()
    (qtest::TestCase test_server_initial_state
      (qtest::assertEqual 'stopped pyStartServer.state ?msg "Initial state must be 'stopped")
      (qtest::assertEqual "default" pyStartServer.id ?msg "Default id must be 'default'")
      (qtest::assertEqual "INFO" pyStartServer.logLevel ?msg "Default logLevel must be 'INFO'")
      (qtest::assertEqual "python" pyStartServer.python ?msg "Default python executable must be 'python'")
      (qtest::assertNil pyStartServer.singleMode ?msg "Default singleMode must be nil")
      (qtest::assertNil pyStartServer.timeout ?msg "Default timeout must be nil")
      (qtest::assertNil pyStartServer.forceTcp ?msg "Default forceTcp must be nil")
      (qtest::assertNil pyStartServer.ipc ?msg "Initial IPC handle must be nil")))

  ;; Suite 5: Server process lifecycle
  (qtest::TestSuite ()
    (qtest::TestCase test_spawn_server_builds_all_command_variants
      (let ((originalBegin (getd '__pyIpcBeginProcess))
            (savedState (__pyTestServerState))
            mockProcess
            commands
            firstResult
            firstState
            secondResult
            secondState)
        (unwindProtect
          (progn
            (putd '__pyIpcBeginProcess
                  (lambda (command _host _dataHandler _errorHandler _postFunc _logFile)
                    (setq commands (cons command commands))
                    mockProcess))

            pyStartServer.id = "workspace"
            pyStartServer.logLevel = "DEBUG"
            pyStartServer.python = "python-test"
            pyStartServer.singleMode = nil
            pyStartServer.forceTcp = nil
            pyStartServer.timeout = nil
            (setq mockProcess 'mockProcess)
            (setq firstResult (__pySpawnServer))
            (setq firstState pyStartServer.state)

            pyStartServer.singleMode = t
            pyStartServer.forceTcp = t
            pyStartServer.timeout = 2.5
            (setq mockProcess nil)
            (setq secondResult (__pySpawnServer))
            (setq secondState pyStartServer.state)

            (setq commands (reverse commands))
            (qtest::assertEqual
              '(t running nil nil nil nil stopped t t t)
              (list firstResult
                    firstState
                    (not (null (index (car commands) "--single")))
                    (not (null (index (car commands) "--force-tcp")))
                    (not (null (index (car commands) "--timeout")))
                    secondResult
                    secondState
                    (not (null (index (cadr commands) "--single")))
                    (not (null (index (cadr commands) "--force-tcp")))
                    (not (null (index (cadr commands) "--timeout 2.5"))))
              ?msg "spawn must cover optional flags and success/failure states"))
          (progn
            (putd '__pyIpcBeginProcess originalBegin)
            (__pyTestRestoreServerState savedState)))))

    (qtest::TestCase test_kill_and_restart_lifecycle
      (let ((originalKill (getd '__pyIpcKillProcess))
            (originalSpawn (getd '__pySpawnServer))
            (savedState (__pyTestServerState))
            kills
            spawnCount
            actual)
        (unwindProtect
          (progn
            (putd '__pyIpcKillProcess
                  (lambda (process)
                    (setq kills (cons process kills))
                    t))
            (putd '__pySpawnServer
                  (lambda ()
                    (setq spawnCount (add1 spawnCount))
                    t))
            (setq spawnCount 0)

            pyStartServer.ipc = nil
            pyStartServer.state = 'stopped
            (setq actual (list (pyKillServer) pyStartServer.state))

            pyStartServer.ipc = 'killProcess
            pyStartServer.restartPending = t
            (setq actual
                  (append actual
                          (list (pyKillServer)
                                pyStartServer.state
                                pyStartServer.restartPending
                                (car kills))))

            pyStartServer.ipc = nil
            (setq actual (append actual (list (pyRestartServer) spawnCount)))

            pyStartServer.ipc = 'restartProcess
            pyStartServer.requestIpc = 'restartProcess
            (setq kills nil)
            (setq actual
                  (append actual
                          (list (pyRestartServer)
                                pyStartServer.state
                                pyStartServer.restartPending
                                kills)))

            pyStartServer.requestIpc = nil
            (setq actual
                  (append actual
                          (list (pyRestartServer) (car kills))))

            (qtest::assertEqual
              '(nil stopped t stopping nil killProcess
                t 1
                t restarting t nil
                t restartProcess)
              actual
              ?msg "kill/restart must handle stopped, request, and direct paths"))
          (progn
            (putd '__pyIpcKillProcess originalKill)
            (putd '__pySpawnServer originalSpawn)
            (__pyTestRestoreServerState savedState))))))

  ;; Suite 6: Log display branches and file cleanup
  (qtest::TestSuite ()
    (qtest::TestCase test_show_log_handles_invalid_missing_and_ring_buffer_files
      (let ((savedLogName pyShowLog.logName)
            (emptyFile (makeTempFileName (strcat (qub::scriptDir) "/qtsrvXXXX")))
            shortFile
            overflowFile
            missingFile)
        (unwindProtect
          (progn
            (__pyTestWriteLines emptyFile nil)
            (setq shortFile
                  (makeTempFileName (strcat (qub::scriptDir) "/qtsrvXXXX")))
            (__pyTestWriteLines shortFile '("one" "two"))
            (setq overflowFile
                  (makeTempFileName (strcat (qub::scriptDir) "/qtsrvXXXX")))
            (__pyTestWriteLines overflowFile '("one" "two" "three"))
            (setq missingFile
                  (makeTempFileName (strcat (qub::scriptDir) "/qtsrvXXXX")))

            (qtest::assertEqual
              '(nil nil t t t)
              (list (pyShowLog 0)
                    (progn
                      pyShowLog.logName = missingFile
                      (pyShowLog 2))
                    (progn
                      pyShowLog.logName = emptyFile
                      (pyShowLog 2))
                    (progn
                      pyShowLog.logName = shortFile
                      (pyShowLog 3))
                    (progn
                      pyShowLog.logName = overflowFile
                      (pyShowLog 2)))
              ?msg "log display must cover validation, open failure, empty, short, and wrapped files"))
          (progn
            pyShowLog.logName = savedLogName
            (when emptyFile (deleteFile emptyFile))
            (when shortFile (deleteFile shortFile))
            (when overflowFile (deleteFile overflowFile))
            (when missingFile (deleteFile missingFile)))))))

  ;; Suite 7: IPC request and callback behavior
  (qtest::TestSuite ()
    (qtest::TestCase test_on_data_writes_error_unbound_warning_success_and_restart
      (let ((originalWrite (getd '__pyIpcWriteProcess))
            (savedState (__pyTestServerState))
            writes
            responses)
        (unwindProtect
          (progn
            (putd '__pyIpcWriteProcess
                  (lambda (process data)
                    (setq writes (cons (list process data) writes))
                    t))

            pyStartServer.restartPending = nil
            pyStartServer.ipc = 'serverProcess
            (__pyOnData 'serverProcess "error(\"qtest boom\")\n")
            (__pyOnData 'serverProcess
                        "makeTable(\"qtestUnbound\")[\"missing\"]\n")
            (__pyOnData 'serverProcess "plus(1 2)\n")
            (__pyOnData 'serverProcess
                        "progn(warn(\"qtest warning\") 7)\n")
            pyStartServer.restartPending = t
            (__pyOnData 'serverProcess "plus(2 3)\n")

            (setq responses (mapcar 'cadr (reverse writes)))
            (qtest::assertEqual
              '(t t t t t t)
              (list (qub::startsWith (nth 0 responses) "failure ")
                    (equal (nth 1 responses) "success error('unbound')\n")
                    (equal (nth 2 responses) "success 3\n")
                    (not (null (index (nth 3 responses) "warning(")))
                    (equal (nth 4 responses) "restart 5\n")
                    (null pyStartServer.requestIpc))
              ?msg "data callback must emit every response class and clear request state"))
          (progn
            (putd '__pyIpcWriteProcess originalWrite)
            (__pyTestRestoreServerState savedState)))))

    (qtest::TestCase test_on_finish_ignores_stale_and_restarts_current_process
      (let ((originalSpawn (getd '__pySpawnServer))
            (savedState (__pyTestServerState))
            (spawnCount 0)
            actual)
        (unwindProtect
          (progn
            (putd '__pySpawnServer
                  (lambda ()
                    (setq spawnCount (add1 spawnCount))
                    t))

            pyStartServer.ipc = 'currentProcess
            pyStartServer.state = 'running
            (__pyOnFinish 'staleProcess 1)
            (setq actual
                  (list pyStartServer.ipc pyStartServer.state spawnCount))

            pyStartServer.restartPending = nil
            (__pyOnFinish 'currentProcess 0)
            (setq actual
                  (append actual
                          (list pyStartServer.ipc
                                pyStartServer.state
                                spawnCount)))

            pyStartServer.ipc = 'restartProcess
            pyStartServer.restartPending = t
            pyStartServer.requestIpc = 'restartProcess
            (__pyOnFinish 'restartProcess 0)
            (setq actual
                  (append actual
                          (list pyStartServer.ipc
                                pyStartServer.state
                                pyStartServer.restartPending
                                pyStartServer.requestIpc
                                spawnCount)))

            (qtest::assertEqual
              '(currentProcess running 0
                nil stopped 0
                nil stopped nil nil 1)
              actual
              ?msg "finish callback must ignore stale ids and restart only when requested"))
          (progn
            (putd '__pySpawnServer originalSpawn)
            (__pyTestRestoreServerState savedState))))))

  ;; Suite 8: Remaining remote serialization branches
  (qtest::TestSuite ()
    (qtest::TestCase test_remote_serialization_handles_regex_other_port_and_fallback
      (let ((port (outstring))
            otherResult
            regexResult
            portResult
            fallbackResult)
        (unwindProtect
          (progn
            ;; The public serializer compiles the production regex before
            ;; entering __pySaveToVariableAndReturn.
            (setq portResult (__pySkillToPython port))
            (setq otherResult
                  (__pySaveToVariableAndReturn
                    (makeTable "not-a-match" nil)))
            (setq regexResult
                  (__pySaveToVariableAndReturn
                    (stringToSymbol "remote@0xabc")))
            (setq fallbackResult (__pySaveToVariableAndReturn 42))

            (let ((mp (outfile "C:/Users/baijunyan/AppData/Local/Temp/srv_s8.txt"))
                  (s8repr (lsprintf "%L" (stringToSymbol "remote@0xabc"))))
              (rexCompile "^[_a-zA-Z]+[:@][x0-9a-fA-F]+$")
              (when mp
                (fprintf mp "s8repr=%L\nrexExec=%L\nother=%L\nregex=%L\nport=%L\nfallback=%L\n"
                         s8repr (rexExecute s8repr) otherResult regexResult portResult fallbackResult)
                (close mp)))

            (qtest::assertEqual
              '(t t t t)
              (list (not (null (index otherResult "__py_OTHER_")))
                    (qub::startsWith regexResult "Remote(")
                    (not (null (index portResult "__py_openfile_")))
                    (eq fallbackResult t))
              ?msg "remote serialization must cover regex, other, port, and fallback"))
          (close port)))))

  ;; Suite 9: Public start and script execution
  (qtest::TestSuite ()
    (qtest::TestCase test_start_server_rejects_duplicate_and_forwards_configuration
      (let ((originalSpawn (getd '__pySpawnServer))
            (savedState (__pyTestServerState))
            (spawnCount 0)
            actual)
        (unwindProtect
          (progn
            (putd '__pySpawnServer
                  (lambda ()
                    (setq spawnCount (add1 spawnCount))
                    t))
            pyStartServer.ipc = 'existingProcess
            (setq actual (list (pyStartServer) spawnCount))

            pyStartServer.ipc = nil
            (setq actual
                  (append actual
                          (list (pyStartServer
                                  ?id "configured"
                                  ?logLevel "DEBUG"
                                  ?singleMode t
                                  ?timeout 4.0
                                  ?python "python-test"
                                  ?forceTcp t)
                                spawnCount
                                pyStartServer.id
                                pyStartServer.logLevel
                                pyStartServer.singleMode
                                pyStartServer.timeout
                                pyStartServer.python
                                pyStartServer.forceTcp
                                pyStartServer.restartPending)))

            (qtest::assertEqual
              '(nil 0 t 1 "configured" "DEBUG" t 4.0 "python-test" t nil)
              actual
              ?msg "start must reject duplicates and store every configuration value"))
          (progn
            (putd '__pySpawnServer originalSpawn)
            (__pyTestRestoreServerState savedState)))))

    (qtest::TestCase test_run_script_returns_process_or_waits
      (let ((originalBegin (getd '__pyIpcBeginProcess))
            (originalWait (getd '__pyIpcWait))
            (savedLogName pyRunScript.logName)
            beginCalls
            waitCalls
            nonBlockingResult
            blockingResult)
        (unwindProtect
          (progn
            (putd '__pyIpcBeginProcess
                  (lambda (command _host _dataHandler _errorHandler _postFunc _logFile)
                    (setq beginCalls (cons command beginCalls))
                    'scriptProcess))
            (putd '__pyIpcWait
                  (lambda (process)
                    (setq waitCalls (cons process waitCalls))
                    t))

            (setq nonBlockingResult
                  (pyRunScript "script.py" ?python "python-test" ?args '("a" "b")))
            (setq blockingResult
                  (pyRunScript "script.py" ?python "python-test" ?block t))

            (qtest::assertEqual
              '(scriptProcess t 2 scriptProcess t)
              (list nonBlockingResult
                    blockingResult
                    (length beginCalls)
                    (car waitCalls)
                    (not (null (index (car beginCalls) "python-test script.py"))))
              ?msg "run script must return non-blocking handles and wait when requested"))
          (progn
            (putd '__pyIpcBeginProcess originalBegin)
            (putd '__pyIpcWait originalWait)
            pyRunScript.logName = savedLogName)))))

  ;; The suite itself is the acceptance criterion for python_server.il.
  (qtest::TestSuite ()
    (qtest::TestCase test_python_server_reaches_full_branch_coverage
      (qtest::assertEqual
        '((62 62) 100.0)
        (list (qcover:::coverageCounts)
              (qcover::report ?minimum 100.0))
        ?msg "python_server.il must retain all 31 decisions at full coverage"))))
