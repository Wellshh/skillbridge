;;; test_allegro_server.ils - Unit tests for the Allegro transaction kernel.

(qcover::load (strcat (qub::scriptDir)
                      "/../../allegrobridge/server/allegro_server.il"))

(defun __abTestRunTransaction (okValue startValue commitValue rollbackValue command)
  (let ((originalOK (getd '__abOKToProceed))
        (originalStart (getd '__abTransactionStart))
        (originalCommit (getd '__abTransactionCommit))
        (originalRollback (getd '__abTransactionRollback))
        calls
        result
        failure)
    (unwindProtect
      (progn
        (putd '__abOKToProceed
              (lambda ()
                (setq calls (cons 'ok calls))
                okValue))
        (putd '__abTransactionStart
              (lambda ()
                (setq calls (cons 'start calls))
                startValue))
        (putd '__abTransactionCommit
              (lambda (mark)
                (setq calls (cons (list 'commit mark) calls))
                commitValue))
        (putd '__abTransactionRollback
              (lambda (mark)
                (setq calls (cons (list 'rollback mark) calls))
                ;; Deliberately overwrite errset.errset.  The transaction
                ;; kernel must already have saved the command failure.
                (errset (plus 1 "rollback-overwrite"))
                rollbackValue))
        (setq result (errset (__abRunTransaction command)))
        (unless result
          (setq failure errset.errset)))
      (progn
        (putd '__abOKToProceed originalOK)
        (putd '__abTransactionStart originalStart)
        (putd '__abTransactionCommit originalCommit)
        (putd '__abTransactionRollback originalRollback)))
    (list result
          failure
          (reverse calls)
          (and (eq originalOK (getd '__abOKToProceed))
               (eq originalStart (getd '__abTransactionStart))
               (eq originalCommit (getd '__abTransactionCommit))
               (eq originalRollback (getd '__abTransactionRollback))))))

(defun __abTestRunOperation (operation okValue startValues commitValues rollbackValues)
  (let ((originalOK (getd '__abOKToProceed))
        (originalStart (getd '__abTransactionStart))
        (originalCommit (getd '__abTransactionCommit))
        (originalRollback (getd '__abTransactionRollback))
        calls
        result
        failure)
    (unwindProtect
      (progn
        (putd '__abOKToProceed
              (lambda ()
                (setq calls (cons 'ok calls))
                okValue))
        (putd '__abTransactionStart
              (lambda ()
                (let ((value (car startValues)))
                  (setq startValues (cdr startValues))
                  (setq calls (cons 'start calls))
                  value)))
        (putd '__abTransactionCommit
              (lambda (mark)
                (let ((value (car commitValues)))
                  (setq commitValues (cdr commitValues))
                  (setq calls (cons (list 'commit mark) calls))
                  value)))
        (putd '__abTransactionRollback
              (lambda (mark)
                (let ((value (car rollbackValues)))
                  (setq rollbackValues (cdr rollbackValues))
                  (setq calls (cons (list 'rollback mark) calls))
                  (errset (plus 1 "rollback-overwrite"))
                  value)))
        (setq result (errset (funcall operation)))
        (unless result
          (setq failure errset.errset)))
      (progn
        (putd '__abOKToProceed originalOK)
        (putd '__abTransactionStart originalStart)
        (putd '__abTransactionCommit originalCommit)
        (putd '__abTransactionRollback originalRollback)))
    (list result
          failure
          (reverse calls)
          (and (eq originalOK (getd '__abOKToProceed))
               (eq originalStart (getd '__abTransactionStart))
               (eq originalCommit (getd '__abTransactionCommit))
               (eq originalRollback (getd '__abTransactionRollback))))))

(defun __abTestMoveOperation (design transformValue refreshValue refdes x y rotation)
  (let ((originalFreshDesign (getd '__abFreshDesign))
        (originalRefreshSymbol (getd '__abRefreshSymbol))
        (originalTransformSymbol (getd '__abTransformSymbol))
        observed
        result
        success)
    (unwindProtect
      (progn
        (putd '__abFreshDesign (lambda () design))
        (putd '__abRefreshSymbol
              (lambda (symbol)
                (when refreshValue symbol)))
        (putd '__abTransformSymbol
              (lambda (symbol delta angle)
                (setq observed (list delta angle))
                transformValue))
        (catch t
          (setq result (__abMoveComponent refdes x y rotation))
          (setq success t)))
      (progn
        (putd '__abFreshDesign originalFreshDesign)
        (putd '__abRefreshSymbol originalRefreshSymbol)
        (putd '__abTransformSymbol originalTransformSymbol)))
    (list success result observed)))

(qtest::runSuites
  (qtest::TestSuite ()
    (qtest::TestCase test_move_rejects_missing_component
      (letseq ((otherComponent (list nil 'name "OTHER" 'symbol nil))
               (design (list nil 'components (list otherComponent)))
               (run (__abTestMoveOperation design t t "__MISSING_COMPONENT__"
                                            1.0 2.0 nil)))
        (qtest::assertNil (car run))
        (qtest::assertNil (caddr run))))

    (qtest::TestCase test_move_rejects_unplaced_component
      (letseq ((component (list nil 'name "R2" 'symbol nil))
               (design (list nil 'components (list component)))
               (run (__abTestMoveOperation design t t "R2" 1.0 2.0 nil)))
        (qtest::assertNil (car run))
        (qtest::assertNil (caddr run))))

    (qtest::TestCase test_move_reports_transform_failure
      (letseq ((symbol (list nil 'xy 1.0:2.0 'rotation 90.0))
               (component (list nil 'name "R3" 'symbol symbol))
               (design (list nil 'components (list component)))
               (run (__abTestMoveOperation design nil t "R3" 1.0 2.0 nil)))
        (qtest::assertNil (car run))
        (qtest::assertTrue (caddr run))))

    (qtest::TestCase test_move_reports_refresh_failure
      (letseq ((symbol (list nil 'xy 1.0:2.0 'rotation 90.0))
               (component (list nil 'name "R4" 'symbol symbol))
               (design (list nil 'components (list component)))
               (run (__abTestMoveOperation design t nil "R4" 1.0 2.0 nil)))
        (qtest::assertNil (car run))
        (qtest::assertTrue (caddr run))))

    (qtest::TestCase test_components_projection_filters_refdes_and_placement
      (letseq ((originalFreshDesign (getd '__abFreshDesign))
               (symbol (list nil 'xy 1.0:2.0 'rotation 0.0))
               (placed (list nil 'name "R1" 'deviceType "RESISTOR"
                             'package "RES_0402" 'class "DISCRETE"
                             'symbol symbol))
               (unplaced (list nil 'name "R2" 'deviceType "RESISTOR"
                               'package "RES_0402" 'class "DISCRETE"
                               'symbol nil))
               (design (list nil 'components (list placed unplaced)))
               allComponents placedComponents matched missing)
        (unwindProtect
          (progn
            (putd '__abFreshDesign (lambda () design))
            (setq allComponents (__abProjectComponents nil t))
            (setq placedComponents (__abProjectComponents nil nil))
            (setq matched (__abProjectComponents "R1" t))
            (setq missing (__abProjectComponents "__MISSING_COMPONENT__" t)))
          (putd '__abFreshDesign originalFreshDesign))
        (qtest::assertEqual 2 (length allComponents))
        (qtest::assertEqual 1 (length placedComponents))
        (qtest::assertEqual 1 (length matched))
        (qtest::assertNil missing)))

    )

  (qtest::TestSuite ()
    (qtest::TestCase test_projection_entrypoints_refresh_design
      (let ((originalFreshDesign (getd '__abFreshDesign))
            (design (list nil 'components nil 'symbols nil 'nets nil))
            (refreshCount 0))
        (unwindProtect
          (progn
            (putd '__abFreshDesign
                  (lambda ()
                    (setq refreshCount (add1 refreshCount))
                    design))
            (__abProjectBoard)
            (__abProjectComponents nil t)
            (__abProjectNets nil)
            (qtest::assertEqual 3 refreshCount))
          (putd '__abFreshDesign originalFreshDesign))))

    (qtest::TestCase test_board_projection_returns_stable_dpl
      (let ((board (__abProjectBoard))
            (design (axlDBGetDesign)))
        (qtest::assertTrue
          (and (stringp (get board 'path))
               (stringp (get board 'units))
               (equal (length design->components)
                      (get board 'component_count))
               (equal (length design->symbols)
                      (get board 'symbol_count))
               (equal (length design->nets)
                      (get board 'net_count)))))))

  (qtest::TestSuite ()
    (qtest::TestCase test_component_projection_has_explicit_placement
      (letseq ((symbol (list nil 'xy 1.0:2.0 'rotation 90.0))
               (component
                 (list nil
                       'name "R1"
                       'deviceType "RESISTOR"
                       'package "RES_0402"
                       'class "DISCRETE"
                       'symbol symbol))
               (placed (__abProjectComponent component))
               (unplaced
                 (__abProjectComponent
                   (list nil
                         'name "R2"
                         'deviceType "RESISTOR"
                         'package "RES_0402"
                         'class "DISCRETE"
                         'symbol nil))))
        (qtest::assertEqual "placed" (get placed 'placement))
        (qtest::assertEqual 1.0 (get placed 'x))
        (qtest::assertEqual 2.0 (get placed 'y))
        (qtest::assertEqual 90.0 (get placed 'rotation))
        (qtest::assertEqual "unplaced" (get unplaced 'placement))
        (qtest::assertNil (get unplaced 'x))
        (qtest::assertNil (get unplaced 'y))
        (qtest::assertNil (get unplaced 'rotation))))

    (qtest::TestCase test_move_finds_placed_component_and_uses_absolute_delta
      (letseq ((symbol (list nil 'xy 1.0:2.0 'rotation 90.0))
               (component
                 (list nil
                       'name "R1"
                       'deviceType "RESISTOR"
                       'package "RES_0402"
                       'class "DISCRETE"
                       'symbol symbol))
               (design (list nil 'components (list component)))
               (preserve (__abTestMoveOperation design t t "R1" 4.0 7.0 nil))
               (zero (__abTestMoveOperation design t t "R1" 4.0 7.0 0.0)))
        (qtest::assertTrue (car preserve))
        (qtest::assertEqual '(3.0 5.0) (car (caddr preserve)))
        (qtest::assertEqual 0.0 (cadr (caddr preserve)))
        (qtest::assertTrue (car zero))
        (qtest::assertEqual '(3.0 5.0) (car (caddr zero)))
        (qtest::assertEqual -90.0 (cadr (caddr zero))))))

