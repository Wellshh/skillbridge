;; test_design  - test attribute access of Design Attrs
;find all Design Attrs
  ;    print out all attributes of Design Parameter type

  (defun test_design (p)
    (pprint (setq dsn (axlGetParam "paramDesign")) p)
    (fprintf p "\n")
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
    (fprintf p "Setting accuracy to: ")
    (pprint (putprop dsn 1 'accuracy) p)	
    (fprintf p "\n")
    (fprintf p "Found accuracy to be: ")	
    (pprint dsn->accuracy  p)
    (fprintf p "\n")
    (fprintf p "Setting width to: ")
   (pprint (dsn->width=10000) p)
    (fprintf p "\n")
    (fprintf p "Found width to be: ")	
   (pprint dsn->width p)	
    (fprintf p "\n")
    (pprint (dsn->units="microns") p)	
    (fprintf p "\n")
    (fprintf p "Found units to be: ")	
    (pprint dsn->units p)
    (fprintf p "\n")
    (fprintf p "Setting height to: ")
   (pprint (dsn->height=15000) p)
    (fprintf p "\n")
    (fprintf p "Found height to be: ")	
   (pprint dsn->height p)	
    (fprintf p "\n")
    (fprintf p "Setting objtype to: ")
   (pprint (dsn->objtype="Design") p)
    (fprintf p "\n")
    (fprintf p "Expecting nil, found objtype to be: ")	
   (pprint dsn->objtype p)	
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
    (fprintf p "\n")
    (fprintf p "Setting design object, found to be: ")
   (pprint (axlSetParam dsn) p)	
    (fprintf p "\n")
    (fprintf p "Retrieving design object, found to be: ")
    (pprint (setq dsn (axlGetParam "paramDesign")) p)
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
   ) ; defun test_design

