   ) ; defun test_design5


  (defun test_design6 (p)
    (pprint (setq dsn (axlGetParam "paramDesign")) p)
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
    (fprintf p "Setting accuracy to: ")
    (pprint (putprop dsn 2 'accuracy) p)	
    (fprintf p "\n")
    (fprintf p "Found accuracy to be: ")	
    (pprint dsn->accuracy  p)
;    (pprint (putprop dsn 35.0 'width) p)
    (fprintf p "\n")
    (fprintf p "Setting width to: ")
   (pprint (dsn->width=10000) p)
    (fprintf p "\n")
    (fprintf p "Found width to be: ")	
   (pprint dsn->width p)	
    (fprintf p "\n")
    (fprintf p "Setting units to: ")
   (pprint (dsn->units="microns") p)	
    (fprintf p "\n")
    (fprintf p "Found units to be: ")	
    (pprint dsn->units p)
    (fprintf p "\n")
    (fprintf p "Setting height to: ")
   (pprint (dsn->height=1000001.0) p)
    (fprintf p "\n")
    (fprintf p "Found height to be: ")	
   (pprint dsn->height p)	
    (fprintf p "\n")
    (fprintf p "Setting origin to: ")
    (pprint (putprop dsn '(10.0  10.0) 'xy) p)
    (fprintf p "\n")
    (fprintf p "Found origin to be: ")	
   (pprint dsn->xy p)	
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
    (fprintf p "\n")
    (fprintf p "Setting design object,expecting nil, found to be: ")
   (pprint (axlSetParam dsn) p)	
    (fprintf p "\n")
    (fprintf p "Returned nil as height too big")
     (fprintf p "\n")
    (fprintf p "Retrieving design object, found to be: ")
    (pprint (setq dsn (axlGetParam "paramDesign")) p)
    (fprintf p "\n")
    (pprint dsn->?? p)
    (fprintf p "\n")
   ) ; defun test_design6

  
(defun axldesign_test ()
 (setq p outfile("bronze.txt", "a"))
 (setq _itemsperline 1)
 (fprintf p "\n\n*test_design:*******************************************\n\n")
 (test_design p)
 (fprintf p "\n\n*test_design1:\n\n")
 (test_design1 p)
 (fprintf p "\n\n*test_design2:\n\n")
 (test_design2 p)
 (fprintf p "\n\n*test_design3:\n\n")
 (test_design3 p)
 (fprintf p "\n\n*test_design4:\n\n")
 (test_design4 p)
 (fprintf p "\n\n*test_design5:\n\n")
 (test_design5 p)
 (fprintf p "\n\n*test_design6:\n\n")
 (test_design6 p)
 (close p)
) ; defun axldesign_test

